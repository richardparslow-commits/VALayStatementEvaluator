[TEMPLATE]
# Copy this file to .env and fill in your values.
# The app speaks to any OpenAI-compatible API endpoint.
#
# Tailored defaults target the QwenCloud Individual Plan Lite subscription.
# Token Plan uses a dedicated sk-sp- API key that MUST be paired with the
# Token Plan base URL below (they do not work against the general MaaS gateway).

# Your QwenCloud Token Plan API key (starts with sk-sp-)
OPENAI_API_KEY=sk-sp-your-key-here

# QwenCloud Token Plan base URL (OpenAI-compatible)
OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Model for the low-volume analysis/scoring/rewrite calls (strong reasoning)
LLM_MODEL_MAIN=qwen3.7-max

# Model for the bulk record-digest passes (cheap — the majority of calls,
# especially on large files)
LLM_MODEL_FAST=qwen3.7-flash

# Optional Fetch Sandbox API key for importing records from a sandbox endpoint
FETCH_SANDBOX_API_KEY=

# Base URL of your Fetch Sandbox instance
FETCH_SANDBOX_BASE_URL=https://fetchsandbox.com

# GET endpoint used to retrieve records; replace with the path defined by your sandbox spec
FETCH_SANDBOX_RECORDS_PATH=/medical_records/{patient_id}

# ---------------------------------------------------------------------------
# Optional CI secrets for the live smoke-test job (GitHub Actions).
# The smoke job reads the same variables as repository secrets when running
# `scripts/smoke_test.py all`. Only OPENAI_API_KEY is required there; leave the
# others unset to fall back to the default base URL and models above.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<same key you set for local runs>
# OPENAI_BASE_URL=<optional override for CI>
# LLM_MODEL_MAIN=<optional override for CI>
# LLM_MODEL_FAST=<optional override for CI>

# ---------------------------------------------------------------------------
# Optional credit-burn gauge for the usage estimator.
# QwenCloud Token Plan doesn't publish fixed credits-per-1M-token rates, so the
# app reports calls + estimated tokens by default and only converts to credits
# when you supply your plan's effective rates below. Set both to see an
# estimated weekly-quota burn (% of VA_LSE_CREDIT_QUOTA) in the results.
# VA_LSE_CREDITS_PER_1M_MAIN=800   # e.g. credits per 1M tokens for qwen3.7-max
# VA_LSE_CREDITS_PER_1M_FAST=200   # e.g. credits per 1M tokens for qwen3.7-flash
# VA_LSE_CREDIT_QUOTA=2500         # your plan's weekly credit quota (default 2500)
