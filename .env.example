# Copy this file to .env and fill in your values.
# The app speaks to any OpenAI-compatible API endpoint.

# Your API key (required to run evaluations/drafts)
OPENAI_API_KEY=sk-your-key-here

# Base URL of the OpenAI-compatible endpoint
OPENAI_BASE_URL=https://ws-tc9lxz8v26y5ywu1.us-east-1.maas.aliyuncs.com/compatible-mode/v1

# Model used for analysis, scoring, and drafting (strong reasoning model)
LLM_MODEL_MAIN=qwen3.7-max

# Model used for bulk document-digest passes over large medical records (fast model)
LLM_MODEL_FAST=qwen3.7-flash
