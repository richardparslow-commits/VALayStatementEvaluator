[TEMPLATE]
# Copy this file to .env and fill in your values.
# The app speaks to any OpenAI-compatible API endpoint.
# Tested with QwenCloud Token Plan (default) and OpenAI; see COMPATIBILITY.md
# and MIGRATION.md for other providers (Ollama via proxy, Azure OpenAI, etc.).
#
# Tailored defaults target the QwenCloud Individual Plan Lite subscription.
# Token Plan uses a dedicated sk-sp- API key that MUST be paired with the
# Token Plan base URL below (they do not work against the general MaaS gateway).

# Your LLM provider API key
# QwenCloud Token Plan: sk-sp-...  |  OpenAI: sk-proj-...  |  Local Ollama: any non-empty string
# See COMPATIBILITY.md for tested endpoints.
OPENAI_API_KEY=sk-sp-your-key-here

# OpenAI-compatible base URL — any POST {base_url}/chat/completions endpoint works.
# QwenCloud Token Plan (default):
OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
# Local Ollama (via OpenAI-compat shim): http://localhost:11434/v1

# Model for the low-volume analysis/scoring/rewrite calls (strong reasoning)
# QwenCloud: qwen3.7-max  |  OpenAI: gpt-4-turbo / gpt-4o  |  Local: your served model id
LLM_MODEL_MAIN=qwen3.7-max

# Model for the bulk record-digest passes (cheap — the majority of calls,
# especially on large files). Use a cheaper model here on large record sets.
# QwenCloud: qwen3.7-flash  |  OpenAI: gpt-4o-mini
LLM_MODEL_FAST=qwen3.7-flash

# Optional Fetch Sandbox API key for importing records from a sandbox endpoint
FETCH_SANDBOX_API_KEY=

# Base URL of your Fetch Sandbox instance
FETCH_SANDBOX_BASE_URL=https://fetchsandbox.com

# GET endpoint used to retrieve records; replace with the path defined by your sandbox spec
FETCH_SANDBOX_RECORDS_PATH=/medical_records/{patient_id}

# Max bytes accepted from a Fetch Sandbox HTTP response (100 MB default)
FETCH_SANDBOX_MAX_RESPONSE_BYTES=104857600

# ---------------------------------------------------------------------------
# Optional CI secrets for the live smoke-test job (GitHub Actions).
# The smoke job reads the same variables as repository secrets when running
# `scripts/smoke_test.py all`. Only OPENAI_API_KEY is required there; leave the
# others unset to fall back to the default base URL and models above.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<same key you set for local runs>
# OPENAI_BASE_URL=<optional override for CI>
# LLM_MODEL_MAIN=<optional override for CI>
# LLM_MODEL_FAST=<optional override for CI>

# ---------------------------------------------------------------------------
# Optional credit-burn gauge for the usage estimator.
# QwenCloud Token Plan doesn't publish fixed credits-per-1M-token rates, so the
# app reports calls + estimated tokens by default and only converts to credits
# when you supply your plan's effective rates below. Set both to see an
# estimated weekly-quota burn (% of VA_LSE_CREDIT_QUOTA) in the results.
# VA_LSE_CREDITS_PER_1M_MAIN=800   # e.g. credits per 1M tokens for qwen3.7-max
# VA_LSE_CREDITS_PER_1M_FAST=200   # e.g. credits per 1M tokens for qwen3.7-flash
# VA_LSE_CREDIT_QUOTA=2500         # your plan's weekly credit quota (default 2500)

# ---------------------------------------------------------------------------
# Usage watchdog (optional, automatic). The app persists every run's token
# totals in usage_history.json (git-ignored) and you can record your plan's
# cumulative "credits used" reading from the QwenCloud console in the sidebar's
# Usage watchdog panel. After two readings separated by new runs it fits your
# effective credits-per-1M rate and uses it as a fallback for the credit-burn
# estimate — no env var needed here. Explicit values below always win.

# ---------------------------------------------------------------------------
# VA.gov record source integration.
# Credentials are entered per-session in the app's VA.gov login form and are
# NEVER written here, to disk, or to logs. Leave VA_GOV_API_BASE_URL unset to
# run VA.gov auth/fetch against an in-memory mock (useful for local dev/demo);
# set it to enable real HTTPS calls to VA.gov's record-retrieval API.
# ---------------------------------------------------------------------------
VA_GOV_API_BASE_URL=

# ---------------------------------------------------------------------------
# Structured application logging. Every Evaluate/Draft run mints a correlation
# id (st.session_state + ContextVar so parallel workers carry it) surfaced in
# each log line and returned to the user as "reference: req_…" on failures.
# Use JSON for aggregation (ELK/CloudWatch/Datadog), plain for local dev.
# VA_LSE_LOG_DIR enables rotating file logging; unset → stdout only (keeps
# docker/Agiloop log drains useful). No medical text / prompts / PII logged.
# ---------------------------------------------------------------------------
# VA_LSE_LOG_LEVEL=INFO          # DEBUG|INFO|WARNING|ERROR
# VA_LSE_LOG_JSON=0              # 1 → JSON lines, 0 → plain text
# VA_LSE_LOG_DIR=                # e.g. logs  (empty = stdout only)
# VA_LSE_LOG_FILE=app.log
# VA_LSE_LOG_MAX_BYTES=10485760  # 10 MiB per file
# VA_LSE_LOG_BACKUPS=5

# Audit log — separate JSON stream for compliance/forensics (see app/audit.py).
# Writes one JSON line per Evaluate/Draft start + ok/error to audit.log in the
# same rotation scheme, but as a distinct logger so retention policies can
# differ from the diagnostic app.log. Fields: action, status, request_id,
# user_session_id, condition (classification only), record_sources, outcome
# (counters/classifications). Never logs statement/observations/record text.
# VA_LSE_AUDIT_LOG_DIR=            # directory for audit.log (default logs, or VA_LSE_LOG_DIR when set)
# VA_LSE_AUDIT_LOG_FILE=audit.log
# VA_LSE_AUDIT_LOG_MAX_BYTES=10485760
# VA_LSE_AUDIT_LOG_BACKUPS=10

# Circuit breaker + concurrency limiter for LLM calls (100-user hardening).
# The breaker opens after N consecutive logical failures (a call that exhausts
# its 3 retries counts as one) and stays open for RECOVERY_SECONDS before
# allowing a probe. While open, every LLM call fails fast (<50 ms, no network)
# so a degraded endpoint is not hammered by concurrent users. State changes log
# at WARNING. The limiter caps simultaneous LLM calls and queues the rest up to
# MAX_DEPTH; beyond that calls are rejected with QueueFullError.
# VA_LSE_CB_FAILURE_THRESHOLD=3
# VA_LSE_CB_RECOVERY_SECONDS=60
# VA_LSE_MAX_CONCURRENT_LLM_CALLS=20
# VA_LSE_LLM_QUEUE_MAX_DEPTH=50
# VA_LSE_LLM_QUEUE_TIMEOUT_SECONDS=30

# Sidecar health probes for container orchestration (see README → Health checks).
# Exposes GET /health (liveness, always 200) and GET /ready (readiness, 503 when
# the LLM gateway/models are unreachable) on 0.0.0.0:{port}. Set to 0 to disable.
# VA_LSE_HEALTH_PORT=8001

# App origin used for CORS allowlisting in split-origin deployments. This is a
# single-origin Streamlit app, so this is currently unused but documented for
# forward compatibility with the deploy harness.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# LLM compatibility & model availability check (see COMPATIBILITY.md / MIGRATION.md).
# On startup the app GETs {OPENAI_BASE_URL}/models and warns if LLM_MODEL_MAIN
# or LLM_MODEL_FAST is not listed (non-blocking; network failures ignored).
# Checked via app/llm.py:check_model_availability — no env var needed.
# To switch providers, just change OPENAI_BASE_URL + OPENAI_API_KEY + the two
# model names here (or in the sidebar). Any OpenAI-compatible endpoint works.

# ---------------------------------------------------------------------------
# Agiloop Inspect telemetry (mandatory agiloop-instrumentation skill).
# Server-side only — this process never ships a browser bundle, so these
# values never leave the Python process. Leave both AGILOOP_INSPECT_API_KEY
# and AGILOOP_PROJECT_ID unset to run telemetry in mock (log-only, no-op) mode.
# ---------------------------------------------------------------------------
AGILOOP_INSPECT_API_KEY=
AGILOOP_INSPECT_URL=https://inspect.api.agiloop.app
AGILOOP_PROJECT_ID=

# ---------------------------------------------------------------------------
# Type checking: `pyproject.toml` enables strict mypy for app/. CI runs `mypy app`
# as a blocking gate (see .github/workflows/test.yml → Static checks). Run locally
# with `pip install -r requirements-dev.txt && mypy app`.

# ---------------------------------------------------------------------------
# Provider switch quick-start (copy one block to the top of this file):
#
# OpenAI:
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL_MAIN=gpt-4-turbo
#   LLM_MODEL_FAST=gpt-4o-mini
#
# QwenCloud Token Plan (default):
#   OPENAI_API_KEY=sk-sp-...
#   OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL_MAIN=qwen3.7-max
#   LLM_MODEL_FAST=qwen3.7-flash
#
# Local Ollama (OpenAI-compat proxy):
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_MAIN=llama3.1:8b
#   LLM_MODEL_FAST=llama3.1:8b
# See MIGRATION.md for full recipes.
# ---------------------------------------------------------------------------
