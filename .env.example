[TEMPLATE]
# Copy this file to .env and fill in your values.
# The app speaks to any OpenAI-compatible API endpoint.
# Defaults target Perplexity's Agent API — the endpoint below, which speaks the
# OpenAI Responses schema ({base_url}/responses) and routes to first-party models
# (OpenAI, Anthropic, Google, xAI) under one Perplexity key at direct provider
# pricing. See COMPATIBILITY.md and MIGRATION.md for the tested alternatives
# (OpenAI, QwenCloud Token Plan, Ollama via proxy, Azure OpenAI, etc.).
#
# Hosted deployments (Streamlit Community Cloud) have no .env: put the same
# KEY = "value" lines in .streamlit/secrets.toml / the dashboard Secrets editor
# instead — the app reads them as a fallback after the environment.
# See DEPLOYMENT.md → Pattern D.
#
# One pplx- key serves both the Agent API below and the Research tab's grounded
# lookups: when OPENAI_BASE_URL is Perplexity's, OPENAI_API_KEY is read as
# PERPLEXITY_API_KEY too. The variable keeps its OpenAI-compatible name.

# Your LLM provider API key
# Perplexity: pplx-...  |  QwenCloud Token Plan: sk-sp-...  |  OpenAI: sk-proj-...
# Local Ollama (via OpenAI-compat shim): any non-empty string
# See COMPATIBILITY.md for tested endpoints.
OPENAI_API_KEY=pplx-your-key-here

# OpenAI-compatible base URL. Perplexity's Agent API is the default — it speaks the
# OpenAI Responses schema at POST {base_url}/responses (the SDK-compatible alias of
# /v1/agent) and routes to first-party models under one Perplexity key.
OPENAI_BASE_URL=https://api.perplexity.ai/v1
# Any Chat-Completions endpoint also works and is detected automatically:
# OpenAI: https://api.openai.com/v1
# QwenCloud Token Plan: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   (the sk-sp- key must be paired with this URL — it fails on other gateways)
# Local Ollama (via OpenAI-compat shim): http://localhost:11434/v1

# Provider-neutral aliases for the two settings above. They exist so a hosted
# tier can be provisioned with generic platform names (LLM_PROVIDER_URL,
# LLM_API_KEY) instead of OpenAI-spelled ones. When both spellings are set the
# canonical OPENAI_* name wins. Leave commented unless you need them.
# LLM_PROVIDER_URL=https://your-baa-endpoint.example/v1
# LLM_API_KEY=your-key-here

# Model for the low-volume analysis/scoring/rewrite calls (strong reasoning)
# Agent API catalog: perplexity/kimi-k3 (default), perplexity/glm-5.3, openai/gpt-5.5, anthropic/claude-sonnet-4-6, google/gemini-3.5-flash, xai/grok-4.5
# QwenCloud: qwen3.7-max  |  OpenAI: gpt-4-turbo / gpt-4o  |  Local: your served model id
# Sonar models are NOT served on the Agent API (live-probed; see
# TROUBLESHOOTING.md → Sonar models) — scripts/sonar_watch.py switches
# them in automatically when a route that serves them passes its probe.
LLM_MODEL_MAIN=perplexity/kimi-k3

# Model for the bulk record-digest passes (cheap — the majority of calls,
# especially on large files). Use a cheaper model here on large record sets.
# Agent API catalog: perplexity/glm-5.3-flash (default),
#                 perplexity/nemotron-3-ultra-550b-a55b, perplexity/glm-5.3
# QwenCloud: qwen3.7-flash  |  OpenAI: gpt-4o-mini
LLM_MODEL_FAST=perplexity/glm-5.3-flash

# Optional: the Research tab's Agent API key. Not needed with the defaults
# above — with a Perplexity base URL, OPENAI_API_KEY is read as this too, so
# one key serves both. Set it when the chat endpoint is a different provider
# and you still want grounded web research.
# PERPLEXITY_API_KEY=

# Optional Fetch Sandbox API key for importing records from a sandbox endpoint
FETCH_SANDBOX_API_KEY=

# Base URL of your Fetch Sandbox instance
FETCH_SANDBOX_BASE_URL=https://fetchsandbox.com

# GET endpoint used to retrieve records; replace with the path defined by your sandbox spec
FETCH_SANDBOX_RECORDS_PATH=/medical_records/{patient_id}

# Max bytes accepted from a Fetch Sandbox HTTP response (100 MB default)
FETCH_SANDBOX_MAX_RESPONSE_BYTES=104857600

# Local filesystem import is disabled by default, including on localhost.
# Opt in only for trusted single-user use, with Streamlit bound to 127.0.0.1.
# Keep this unset or 0 on hosted/shared deployments; use file uploads there.
#
# WARNING: enabling this (VA_LSE_ALLOW_LOCAL_PATHS=1) on a publicly accessible
# or shared hosted deployment introduces a SEVERE Local File Inclusion (LFI) /
# path-traversal risk: any end-user who can reach the app can make the server
# read arbitrary paths on the host machine - its own files, other users' data,
# the deployment's credentials - and return the contents through the records
# pipeline. This flag is for SINGLE-USER, LOCAL DESKTOP USE ONLY, with the
# server bound to 127.0.0.1; it must never be enabled on any hosted, shared,
# or reverse-proxied deployment. (The app refuses to enable local imports
# unless it can prove a loopback bind - treat that guard as a backstop, never
# as permission.)
# VA_LSE_ALLOW_LOCAL_PATHS=0

# ---------------------------------------------------------------------------
# Optional: read records on the sandbox image, the only image here with OCR
# tooling — that is how a scanned page gets text. See DEPLOYMENT.md §6 and
# README → Scanned pages and OCR. The runner command is this repository's:
# VA_LSE_EXTRACTOR=sandbox
# VA_LSE_EXTRACTOR_RUNNER="python scripts/vercel_sandbox_runner.py {work}"
#   Knobs the runner reads (defaults shown; it needs the Sandbox CLI and the
#   va-lse-sandbox image pushed to Vercel Container Registry):
# VA_LSE_SANDBOX_CLI=sandbox
# VA_LSE_SANDBOX_IMAGE=va-lse-sandbox:latest
# VA_LSE_SANDBOX_TIMEOUT=20m
# VA_LSE_SANDBOX_SCOPE=
# VA_LSE_SANDBOX_PROJECT=
# Sandbox credential (read only when VA_LSE_EXTRACTOR=sandbox): a Vercel *access
# token* (Account Settings -> Tokens, scoped to the team) or a Function's
# VERCEL_OIDC_TOKEN. An AI Gateway key (vck-...) is a different product and the
# runner refuses it by name; unset everywhere = the CLI's `sandbox login` session.
# VA_LSE_SANDBOX_TOKEN=
# VERCEL_OIDC_TOKEN=
# VERCEL_TOKEN=

# ---------------------------------------------------------------------------
# Optional CI secrets for the live smoke-test job (GitHub Actions).
# The smoke job reads the same variables as repository secrets when running
# `scripts/smoke_test.py all`. Only OPENAI_API_KEY is required there; leave the
# others unset to fall back to the default base URL and models above.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<same key you set for local runs>
# OPENAI_BASE_URL=<optional override for CI>
# LLM_MODEL_MAIN=<optional override for CI>
# LLM_MODEL_FAST=<optional override for CI>

# ---------------------------------------------------------------------------
# Optional credit-burn gauge for the usage estimator.
# No provider publishes a fixed credits-per-1M-token rate (QwenCloud Token
# Plan's changes; Perplexity bills per token in USD), so the app reports calls
# + estimated tokens by default and only converts to a plan figure when you
# supply your own rates below. The "credits" are whatever unit you record.
# VA_LSE_CREDITS_PER_1M_MAIN=800   # e.g. units per 1M tokens, main model
# VA_LSE_CREDITS_PER_1M_FAST=200   # e.g. units per 1M tokens, fast model
# VA_LSE_CREDIT_QUOTA=             # your plan's weekly allowance in those units
#                                  # (unset: burn shows without a percentage)

# ---------------------------------------------------------------------------
# Usage watchdog (optional, automatic). The app persists every run's token
# totals in usage_history.json (git-ignored) and you can record your plan's
# cumulative units-used reading in the sidebar's Usage watchdog panel — the
# console figure for whatever unit your rates are in (QwenCloud Token Plan
# credits, or a pay-per-token provider's spend). After two readings separated
# by new runs it fits your effective units-per-1M rate and uses it as a
# fallback for the estimate — no env var needed here. Explicit values always win.

# ---------------------------------------------------------------------------
# VA.gov record source integration.
# Credentials are entered per-session in the app's VA.gov login form and are
# NEVER written here, to disk, or to logs. Leave VA_GOV_API_BASE_URL unset to
# run VA.gov auth/fetch against an in-memory mock (useful for local dev/demo);
# set it to enable real HTTPS calls to VA.gov's record-retrieval API.
# ---------------------------------------------------------------------------
VA_GOV_API_BASE_URL=

# ---------------------------------------------------------------------------
# Structured application logging. Every Evaluate/Draft run mints a correlation
# id (st.session_state + ContextVar so parallel workers carry it) surfaced in
# each log line and returned to the user as "reference: req_…" on failures.
# Use JSON for aggregation (ELK/CloudWatch/Datadog), plain for local dev.
# VA_LSE_LOG_DIR enables rotating file logging; unset → stdout only (keeps
# docker/Agiloop log drains useful). No medical text / prompts / PII logged.
# ---------------------------------------------------------------------------
# VA_LSE_LOG_LEVEL=INFO          # DEBUG|INFO|WARNING|ERROR
# VA_LSE_LOG_JSON=0              # 1 → JSON lines, 0 → plain text
# VA_LSE_LOG_DIR=                # e.g. logs  (empty = stdout only)
# VA_LSE_LOG_FILE=app.log
# VA_LSE_LOG_MAX_BYTES=10485760  # 10 MiB per file
# VA_LSE_LOG_BACKUPS=5

# Audit log — separate JSON stream for compliance/forensics (see app/audit.py).
# Writes one JSON line per Evaluate/Draft start + ok/error to audit.log in the
# same rotation scheme, but as a distinct logger so retention policies can
# differ from the diagnostic app.log. Fields: action, status, request_id,
# user_session_id, condition (classification only), record_sources, outcome
# (counters/classifications). Never logs statement/observations/record text.
# VA_LSE_AUDIT_LOG_DIR=            # directory for audit.log (default logs, or VA_LSE_LOG_DIR when set)
# VA_LSE_AUDIT_LOG_FILE=audit.log
# VA_LSE_AUDIT_LOG_MAX_BYTES=10485760
# VA_LSE_AUDIT_LOG_BACKUPS=10
#
# error_message in an audit entry is arbitrary upstream exception text (a library
# can put anything in an exception message), so it is NOT covered by the "counts
# and classifications only" contract above. It is scrubbed of PII-shaped tokens
# and whitespace-collapsed; set this to 0 to omit it entirely, which is what a
# deployment shipping audit logs to third-party storage should do. error_class is
# always recorded and always safe.
# VA_LSE_AUDIT_ERROR_MESSAGES=1

# Audit log retention + off-pod backup (see app/audit_backup.py and
# scripts/backup_audit_logs.py — run as a CronJob or sidecar, not inside the app).
#
# Rotation bounds the audit stream's SIZE (max_bytes x (backups + 1), ~110 MiB) but
# knows nothing about time: during a busy period it deletes a file younger than the
# retention window. VA_LSE_AUDIT_RETENTION_DAYS is the age half of the rule; the
# effective local retention is whichever limit is reached first. The backup pass
# ships rotated files AND the un-shipped tail of the live audit.log, so a file that
# will not rotate for weeks is still copied off the pod.
#
# The destination must be genuinely off the pod. A filesystem destination on the
# pod's own volume is allowed but reported as off_pod: false in /health, because it
# cannot survive the pod failure a backup exists to survive. In Kubernetes the log
# directory must also be a persistent volume first — see deploy/k8s/k8s-logs.yaml;
# nothing can back up an emptyDir that vanishes with its pod.
# VA_LSE_AUDIT_RETENTION_DAYS=7
# VA_LSE_AUDIT_BACKUP_DESTINATION=            # filesystem | s3 | gcs | azure (unset = off)
# VA_LSE_AUDIT_BACKUP_INTERVAL_HOURS=6
# VA_LSE_AUDIT_BACKUP_CLOUD_RETENTION_DAYS=90
# VA_LSE_AUDIT_BACKUP_REQUIRED=0              # 1 → the CLI exits 2 when unconfigured
# VA_LSE_AUDIT_BACKUP_DIR=                    # destination=filesystem
# VA_LSE_AUDIT_BACKUP_S3_BUCKET=              # destination=s3   (needs requirements-backup.txt)
# VA_LSE_AUDIT_BACKUP_S3_PREFIX=
# VA_LSE_AUDIT_BACKUP_S3_ENDPOINT_URL=        # MinIO / R2 / Spaces / GCS interop mode
# VA_LSE_AUDIT_BACKUP_GCS_BUCKET=             # destination=gcs
# VA_LSE_AUDIT_BACKUP_GCS_PREFIX=
# VA_LSE_AUDIT_BACKUP_AZURE_CONTAINER=        # destination=azure
# VA_LSE_AUDIT_BACKUP_AZURE_ACCOUNT_URL=
#   (Azure also reads AZURE_STORAGE_CONNECTION_STRING when set)

# Diagnostic run log (logs/runs.jsonl). Size-bounded like the audit log; before
# this existed it was the only unbounded writer in the app.
# VA_LSE_RUN_LOG_MAX_BYTES=10485760
# VA_LSE_RUN_LOG_BACKUPS=5

# Free-space floor for the log volume. Below it, /health → disk.below_floor is true
# and audit.write_failures tells you whether records are already being lost. Purely
# a signal: audit writes are never dropped to save space.
# VA_LSE_DISK_MIN_FREE_BYTES=268435456   # 256 MiB

# Circuit breaker + concurrency limiter for LLM calls (100-user hardening).
# The breaker opens after N consecutive logical failures (a call that exhausts
# its 3 retries counts as one) and stays open for RECOVERY_SECONDS before
# allowing a probe. While open, every LLM call fails fast (<50 ms, no network)
# so a degraded endpoint is not hammered by concurrent users. State changes log
# at WARNING. The limiter caps simultaneous LLM calls and queues the rest up to
# MAX_DEPTH; beyond that calls are rejected with QueueFullError.
# VA_LSE_CB_FAILURE_THRESHOLD=3
# VA_LSE_CB_RECOVERY_SECONDS=60
# VA_LSE_MAX_CONCURRENT_LLM_CALLS=20
# VA_LSE_LLM_QUEUE_MAX_DEPTH=50
# VA_LSE_LLM_QUEUE_TIMEOUT_SECONDS=30

# Sidecar health probes for container orchestration (see README → Health checks).
# Exposes GET /health (liveness, always 200) and GET /ready (readiness, 503 when
# the LLM gateway/models are unreachable) on 0.0.0.0:{port}. Set to 0 to disable.
# VA_LSE_HEALTH_PORT=8001

# ---------------------------------------------------------------------------
# Graceful shutdown (see README → Graceful shutdown).
# On SIGTERM the app stops accepting new Evaluate/Draft runs, flips /ready to
# 503 so the orchestrator drains traffic, and waits up to SHUTDOWN_GRACE_SECONDS
# for inflight runs to finish before the orchestrator's SIGKILL arrives. Each
# LLM call is bounded by LLM_CALL_TIMEOUT_SECONDS so a single hung call cannot
# block the drain forever.
# VA_LSE_SHUTDOWN_GRACE_SECONDS=30   # max seconds to wait for inflight runs
# VA_LSE_LLM_CALL_TIMEOUT_SECONDS=300  # per-call timeout (5 min default)

# ---------------------------------------------------------------------------
# Pipeline-level timeout and memory monitoring (see app/pipeline_guard.py).
# PIPELINE_TIMEOUT_SECONDS caps the total wall-clock time for an entire
# Evaluate or Draft run (including record digest, merge, and all LLM calls).
# If exceeded, the run is aborted with a user-visible error. MEMORY_WARN_MB
# is the RSS threshold (in MB) above which a warning is logged; below 200 MB
# the run is aborted with MemoryError.
# VA_LSE_PIPELINE_TIMEOUT_SECONDS=1800  # 30 min default
# VA_LSE_MEMORY_WARN_MB=500            # warn when RSS exceeds this

# ---------------------------------------------------------------------------
# Record ingest & review quality (see app/documents.py — "Reading the results"
# in README.md describes what each one buys).
#
# Everything here is best-effort heuristics over messy real-world files, so each
# knob is a trade-off rather than a correctness switch, and the defaults are the
# tested configuration. The coverage report tells you which of them mattered for
# a given record set.
# ---------------------------------------------------------------------------
# Characters per synthesized block for sources with NO page numbers (.txt/.md/
# .docx). Long text is addressed in blocks so citations resolve to somewhere in
# the file instead of every fact claiming "p.1" of a 200-page document.
# VA_LSE_DOCUMENT_BLOCK_CHARS=4000

# Upper bound on one retrieval unit. A PDF page with no blank lines arrives as a
# single block, which would otherwise be one ranking unit for the whole page.
# VA_LSE_PARAGRAPH_MAX_CHARS=1500

# Try pypdf's layout-preserving extraction on pages whose default read looks weak
# or carries no dates. Multi-column labs/vitals keep date|value rows intact under
# layout mode; the default reader interleaves the columns.
# VA_LSE_PDF_LAYOUT_EXTRACTION=1

# Running header/footer stripping: a line on more than this share of pages is
# boilerplate, in documents of at least VA_LSE_RUNNING_LINE_MIN_PAGES pages. Lines
# containing a date are never stripped (an encounter date that repeats is content).
# VA_LSE_RUNNING_LINE_RATIO=0.6
# VA_LSE_RUNNING_LINE_MIN_PAGES=3

# Duplicate-page removal is exact-text only (newline encoding is normalized).
# The former VA_LSE_DUPLICATE_PAGE_SIMILARITY setting is ignored; changed
# clinical values and near-matching pages are always retained for review.

# Undated facts are dated by the model in batches of this size. One call for every
# undated fact in a large bundle truncates and loses the whole batch.
# VA_LSE_UNDATED_FACT_BATCH_SIZE=40

# Below this keyword-overlap score, retrieved raw evidence counts as "nothing
# matched", and a would-be CONTRADICTED verdict is reported as a record-coverage
# gap instead. Raise it to be stricter about calling a claim unsupported.
# VA_LSE_EVIDENCE_WEAK_OVERLAP=0.05

# Warn in the uploader once a record set exceeds this many pages: the review will
# be slow; prompt selections are bounded but extracted evidence is retained.
# VA_LSE_RECORD_SIZE_WARN_PAGES=800

# Uploaded .zip expansion bounds (provider portals hand records back as folders,
# so an archive is accepted). An archive is untrusted input and its members are
# held in memory, so every dimension is capped: member count, per-member
# uncompressed size, total uncompressed size, and per-member compression ratio
# (a highly-compressed member is not a plausible records file). Individual
# members over a bound are skipped with a warning; exceeding the total aborts the
# archive. Nested archives are never expanded.
# VA_LSE_ZIP_MAX_MEMBERS=200
# VA_LSE_ZIP_MAX_MEMBER_BYTES=52428800
# VA_LSE_ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
# VA_LSE_ZIP_MAX_COMPRESSION_RATIO=200

# ---------------------------------------------------------------------------
# Distributed cache for VA reference data (see app/shared_cache.py).
# When VA_LSE_SHARED_CACHE_URL and VA_LSE_SHARED_CACHE_TOKEN are set, the app
# uses Upstash Redis (or Vercel KV) as a shared cache across all Streamlit
# instances — condition topics, rating tables, and other VA reference data are
# fetched once and shared.  Without these vars the app uses a process-local
# LRU (256 entries) which is fine for single-instance deployments.
#
# Setup (Upstash, free tier):
#   1. Create a Redis database at https://console.upstash.com/
#   2. Copy the REST URL and token (HTTP API, not the redis:// URL)
#   3. Set VA_LSE_SHARED_CACHE_URL and VA_LSE_SHARED_CACHE_TOKEN below
#   4. Restart the app — /ready will report cache backend and hit rate
# ---------------------------------------------------------------------------
# VA_LSE_SHARED_CACHE_URL=https://your-db.upstash.io
# VA_LSE_SHARED_CACHE_TOKEN=AYxx...
# VA_LSE_SHARED_CACHE_TIMEOUT_SECONDS=2  # HTTP timeout per cache call
# VA_LSE_SHARED_CACHE_LOCAL_MAXSIZE=256   # local LRU fallback entries

# ---------------------------------------------------------------------------
# Distributed job queue (Pattern C) — run Evaluate/Draft on worker pods.
# See DEPLOYMENT.md → Pattern C and app/job_queue.py.
#
# When enabled, a run is submitted to a queue instead of executing inside the
# Streamlit process, so a 2,000-page digest no longer pins the pod that owns the
# browser session (~1.8 GB, ~35 min). The web pod only polls a small status key.
# Leave this OFF for single-instance and dev use — the app then behaves exactly
# as it always has.
#
# The transport is auto-selected:
#   1. VA_LSE_REDIS_URL set            → redis-py against Redis (needs `redis`,
#                                        already in requirements.txt)
#   2. VA_LSE_SHARED_CACHE_URL/_TOKEN  → the Upstash REST tier above (stdlib only)
#   3. neither                         → in-process (single process only; a worker
#                                        in another process cannot see those jobs)
#
# IMPORTANT: workers have no browser session, so the API key must be in the
# worker's ENVIRONMENT or deployed secret — a key typed into the sidebar cannot
# reach them. The app refuses to queue a run when it is missing.
# ---------------------------------------------------------------------------
# VA_LSE_JOB_QUEUE=1                    # 1 = submit runs to a worker pool
# VA_LSE_REDIS_URL=redis://va-lse-redis:6379/0   # in-cluster Redis backend
# VA_LSE_JOB_QUEUE_PREFIX=va_lse        # key namespace in Redis
# VA_LSE_JOB_QUEUE_TTL_SECONDS=86400    # lifetime of a finished job's payload/result
# VA_LSE_JOB_QUEUE_LEASE_SECONDS=900    # re-queue a job whose worker stopped heartbeating
# VA_LSE_JOB_QUEUE_POLL_SECONDS=1.0     # worker claim poll interval
# VA_LSE_JOB_QUEUE_UI_POLL_SECONDS=2.5  # browser status poll interval
# VA_LSE_JOB_QUEUE_MAX_PAYLOAD_BYTES=33554432  # 32 MB cap on one job's extracted text
# VA_LSE_WORKER_CONCURRENCY=1           # jobs one worker process runs at once
# VA_LSE_WORKER_HEALTH_PORT=8002        # worker /health sidecar (0 disables)
# VA_LSE_WORKER_ID=                     # worker name in logs (defaults to host:pid)

# ---------------------------------------------------------------------------
# Job documents too large to inline (Pattern C only — see app/blob_store.py).
#
# Extraction happens on the web pod, so the queue carries the *extracted text*,
# not the uploaded PDFs, and a 5,000-page bundle is far more than Redis should
# hold (the reference StatefulSet evicts the largest keys first). Above
# VA_LSE_JOB_QUEUE_INLINE_MAX_BYTES the web pod writes the documents here and
# queues a short content-addressed reference instead; below it the job stays
# inline, so the zero-configuration path keeps working. Either way the job
# payload is bounded by VA_LSE_JOB_QUEUE_MAX_PAYLOAD_BYTES.
#
#   auto (default)   filesystem when the queue is on, else no blob store
#   filesystem       VA_LSE_BLOB_DIR, stdlib only
#   s3               VA_LSE_BLOB_S3_BUCKET (needs boto3 — requirements-s3.txt)
#   none             never externalize; every job must fit the payload cap
#
# VA_LSE_BLOB_DIR MUST be shared by the web tier and every worker: a per-pod
# emptyDir writes happily and then fails on the worker. On Kubernetes that is
# the ReadWriteMany PVC in deploy/k8s/k8s-blobs.yaml; with Compose it is the
# `job-blobs` named volume.
# ---------------------------------------------------------------------------
# VA_LSE_JOB_QUEUE_INLINE_MAX_BYTES=262144   # 256 KB — above this, externalize
# VA_LSE_BLOB_STORE=auto                     # auto | filesystem | s3 | none
# VA_LSE_BLOB_DIR=blobs                      # filesystem root (shared volume)
# VA_LSE_BLOB_S3_BUCKET=                     # s3: bucket name
# VA_LSE_BLOB_S3_PREFIX=va-lse               # s3: key prefix
# VA_LSE_BLOB_S3_ENDPOINT_URL=               # s3: MinIO/R2/Spaces endpoint (blank = AWS)

# ---------------------------------------------------------------------------
# Production profiler (see app/profiler.py, PERFORMANCE.md).
# When VA_LSE_PROFILE_RUNS=1 the app emits per-phase timing breakdowns
# (p50/p95/p99) to the structured log after each Evaluate/Draft run.
# Disabled by default to avoid overhead in production.
# VA_LSE_PROFILE_RUNS=1

# ---------------------------------------------------------------------------
# Distributed tracing (OpenTelemetry) — see TRACING.md.
#
# Off by default and a no-op when the OpenTelemetry packages are absent, so the
# default install behaves exactly as it did before tracing existed. When on, one
# trace covers a run end to end: the root run span, a span per pipeline phase,
# and (in Pattern C) the worker that executes it — joined to the web pod's
# submit span through the job payload.
#
# Spans export over OTLP, which Jaeger, Grafana Tempo, Datadog, New Relic and
# Honeycomb all ingest, so the backend is an env change, not a code change. The
# exporter reads the standard OpenTelemetry variables, so vendor docs apply
# verbatim: OTEL_EXPORTER_OTLP_ENDPOINT (or ..._TRACES_ENDPOINT), _HEADERS,
# _TIMEOUT, _COMPRESSION, OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES,
# OTEL_TRACES_SAMPLER, OTEL_SDK_DISABLED.
#
# PHI: traces carry phase names, counts, sizes, model names and the run's
# request id — never statement, observation or record text. They do leave the
# deployment, so use a self-hosted collector (Jaeger/Tempo) if that matters for
# your data — see TRACING.md.
# ---------------------------------------------------------------------------
# VA_LSE_TRACING=1                      # 1 = emit OpenTelemetry traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # collector / APM intake
# OTEL_EXPORTER_OTLP_HEADERS=api-key=...    # when the backend needs a key
# OTEL_SERVICE_NAME=va-lay-statement-evaluator
# VA_LSE_TRACE_SAMPLE_RATIO=1.0         # fraction of runs traced (0.0–1.0)
# VA_LSE_TRACE_CHUNK_SPANS=0            # 1 = one span per record-digest chunk
# VA_LSE_TRACE_LLM_CALLS=0              # 1 = one span per LLM provider call
# VA_LSE_TRACE_ROLE=web                 # web | worker (spans carry the tier)

# App origin used for CORS allowlisting in split-origin deployments. This is a
# single-origin Streamlit app, so this is currently unused but documented for
# forward compatibility with the deploy harness.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# LLM compatibility & model availability check (see COMPATIBILITY.md / MIGRATION.md).
# On startup the app GETs {OPENAI_BASE_URL}/models and warns if LLM_MODEL_MAIN
# or LLM_MODEL_FAST is not listed (non-blocking; network failures ignored).
# Checked via app/llm.py:check_model_availability — no env var needed.
# To switch providers, just change OPENAI_BASE_URL + OPENAI_API_KEY + the two
# model names here (or in the sidebar). Any OpenAI-compatible endpoint works.

# ---------------------------------------------------------------------------
# Agiloop Inspect telemetry (mandatory agiloop-instrumentation skill).
# Server-side only — this process never ships a browser bundle, so these
# values never leave the Python process. Leave both AGILOOP_INSPECT_API_KEY
# and AGILOOP_PROJECT_ID unset to run telemetry in mock (log-only, no-op) mode.
# ---------------------------------------------------------------------------
AGILOOP_INSPECT_API_KEY=
AGILOOP_INSPECT_URL=https://inspect.api.agiloop.app
AGILOOP_PROJECT_ID=

# ---------------------------------------------------------------------------
# Type checking: `pyproject.toml` enables strict mypy for app/. CI runs `mypy app`
# as a blocking gate (see .github/workflows/test.yml → Static checks). Run locally
# with `pip install -r requirements-dev.txt && mypy app`.

# ---------------------------------------------------------------------------
# Provider switch quick-start (copy one block to the top of this file):
#
# Perplexity Agent API (default):
#   OPENAI_API_KEY=pplx-...
#   OPENAI_BASE_URL=https://api.perplexity.ai/v1
#   LLM_MODEL_MAIN=perplexity/kimi-k3
#   LLM_MODEL_FAST=perplexity/glm-5.3-flash
#   (Responses schema at {base_url}/responses; multi-provider catalog at
#    https://docs.perplexity.ai/docs/agent-api/models — openai/gpt-5.5, anthropic/claude-sonnet-4-6, google/gemini-3.5-flash, ... — GET {base_url}/models lists the live catalog; an unknown id is a 400 naming it)
#
# OpenAI:
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL_MAIN=gpt-4-turbo
#   LLM_MODEL_FAST=gpt-4o-mini
#
# QwenCloud Token Plan:
#   OPENAI_API_KEY=sk-sp-...
#   OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL_MAIN=qwen3.7-max
#   LLM_MODEL_FAST=qwen3.7-flash
#
# Vercel AI Gateway (OpenAI-compatible; a Vercel key, not a provider key):
#   OPENAI_API_KEY=vck-...
#   OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
#   LLM_MODEL_MAIN=moonshotai/kimi-k3
#   LLM_MODEL_FAST=alibaba/qwen3.7-flash
#   (ids come from the gateway's own catalog, so the Agent API ids above are not
#    listed; the tier decides what a key may call. The Research tab still needs
#    PERPLEXITY_API_KEY — the gateway does not serve the Perplexity Agent API.)
#
# Local Ollama (OpenAI-compat proxy):
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_MAIN=llama3.1:8b
#   LLM_MODEL_FAST=llama3.1:8b
# See MIGRATION.md for full recipes.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OPTIONAL second LLM endpoint (failover). See DEPLOYMENT.md → "LLM endpoint
# failover (optional)" and COMPATIBILITY.md.
#
# Leave OPENAI_BASE_URL_FALLBACK unset (the default) and the app runs on exactly
# one endpoint with no extra probe and no behaviour change. Setting it arms
# failover: once the PRIMARY has been failing continuously for
# LLM_ENDPOINT_FALLBACK_TIMEOUT_SECONDS (default 300s), calls are routed to this
# endpoint instead, and routed back automatically as soon as the primary answers
# a call again.
#
# A fallback is usually a DIFFERENT provider, which needs its own key and its own
# model names — a key for one provider authenticates nothing at the other. Each
# unset value inherits the primary's, so a second gateway under the same account
# needs only OPENAI_BASE_URL_FALLBACK.
#
# Example: OpenAI as the backup for a Perplexity primary.
#   OPENAI_BASE_URL_FALLBACK=https://api.openai.com/v1
#   OPENAI_API_KEY_FALLBACK=sk-proj-...
#   LLM_MODEL_MAIN_FALLBACK=gpt-4-turbo
#   LLM_MODEL_FAST_FALLBACK=gpt-4o-mini
#   LLM_ENDPOINT_FALLBACK_TIMEOUT_SECONDS=300
#
# Note: this is a GRACE PERIOD before failover engages, NOT an HTTP request
# timeout (that is VA_LSE_LLM_CALL_TIMEOUT_SECONDS). Lower it to fail over sooner;
# 0 means "fail over as soon as the primary is unhealthy". Runs served by the
# fallback are stamped in the audit record and the run log (llm_endpoints), and
# va_lse_llm_failover_active is 1 while it is happening.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL_FALLBACK=
OPENAI_API_KEY_FALLBACK=
LLM_MODEL_MAIN_FALLBACK=
LLM_MODEL_FAST_FALLBACK=
# LLM_ENDPOINT_FALLBACK_TIMEOUT_SECONDS=300
