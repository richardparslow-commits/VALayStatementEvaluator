#!/usr/bin/env bash
# Prevent accidental commit of secrets / .env files, and refuse the two
# repository rules below at the moment they are broken rather than in CI.
#
# Install as a *link*, or point git at this directory — not a copy. This file's
# rules are modules it resolves from the checkout (and it is edited whenever one
# is added), so a checkout holding a copy keeps running the version it was copied
# from: it reports green while checking less than this file claims, which is the
# one failure a gate may not have. Rule 5 is the response — this version compares
# the bytes being run with the checkout's own hook and refuses a mismatch — and a
# copy older than that check cannot notice, because noticing is the check.
#   ln -sfn ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#   git config core.hooksPath scripts/hooks
# Or wire via pre-commit.com (see SECURITY.md).
#
# This hook:
#   1. Blocks staged files matching secret-bearing path patterns.
#   2. Scans the staged diff for lines that look like embedded API keys
#      (sk-*, OPENAI_API_KEY=, etc.) or generic high-entropy key assignments.
#   3. Refuses staged test modules that are not wired into the hermetic harness
#      (tests/harness_imports.py, the same rule the suite scans with).
#   4. Refuses staged app modules that read a Streamlit config option
#      (tests/streamlit_option_reads.py, likewise shared with the suite).
#   5. Refuses the commit when the bytes that ran are not this checkout's own
#      hook — a copy, or a link into another checkout, checks what it checked the
#      day it was installed, and only the bytes can say which version that was.

set -e

# ``R`` travels with a rename: ``git mv notes.txt .env`` stages the destination as
# a rename, and with ``ACM`` none of the checks below ever saw that path — the
# escape ``tests/staged_sources.py`` closes for the rules with its own filter.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
STAGED_DIFF=$(git diff --cached 2>/dev/null || true)

FAIL=0

# ---------------------------------------------------------------- install
# Which file is running is the one fact no rule can recover. The modules a rule
# calls resolve from this checkout, but the hook around them is whatever was
# installed: a copy frozen the day it was made, or — since every worktree shares
# the main checkout's ``.git/hooks`` — another checkout's link. Compare the bytes
# being run with this checkout's own hook and refuse a mismatch.
RUNNING="${BASH_SOURCE[0]:-$0}"
TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || true)
CANONICAL="$TOPLEVEL/scripts/hooks/pre-commit"
if [ -n "$TOPLEVEL" ] && [ -f "$CANONICAL" ]; then
  running_hash=$(git hash-object "$RUNNING" 2>/dev/null || true)
  canonical_hash=$(git hash-object "$CANONICAL" 2>/dev/null || true)
  if [ -n "$running_hash" ] && [ "$running_hash" != "$canonical_hash" ]; then
    echo "✖  Blocked: the pre-commit hook that ran is not this checkout's hook." >&2
    echo "   ran:  $RUNNING" >&2
    echo "   here: $CANONICAL" >&2
    echo "   A copy, or a link into another checkout, keeps checking what it" >&2
    echo "   checked the day it was installed — green while this checkout's hook" >&2
    echo "   would have checked more. Point git at this checkout's own file:" >&2
    echo "     git config core.hooksPath scripts/hooks" >&2
    FAIL=1
  fi
fi

# ---------------------------------------------------------------- files
block_pattern=0
for file in $STAGED_FILES; do
  # Allow .env.example; block every other .env variant.
  if [[ "$file" == ".env" ]] \
    || [[ "$file" == ".env.local" ]] \
    || [[ "$file" == .env.*".local" ]] \
    || [[ "$file" == *".env.local" ]] \
    || [[ "$file" == ".streamlit/secrets.toml" ]] \
    || [[ "$file" == *.pem ]] \
    || [[ "$file" == *.key ]]; then
    echo "✖  Blocked: staged file '$file' is secret-bearing and must not be committed." >&2
    echo "   Remove it from the index (git reset HEAD -- \"$file\") and ensure .gitignore covers it." >&2
    block_pattern=1
    FAIL=1
  fi
done

# Also detect any .env* file not covered above (e.g. .env.dev, .env.bak in a subdirectory).
for file in $STAGED_FILES; do
  base=$(basename "$file")
  if [[ "$base" == .env* ]] && [[ "$base" != ".env.example" ]]; then
    # already reported under exact patterns above? report once.
    if [[ "$block_pattern" == 0 || ( "$file" != ".env" && "$file" != ".env.local" && "$file" != ".streamlit/secrets.toml" ) ]]; then
      # Avoid duplicate message for files already caught above.
      if [[ "$file" != ".env" ]] && [[ "$file" != ".env.local" ]] && [[ "$file" != ".streamlit/secrets.toml" ]] && [[ "$file" != *.pem ]] && [[ "$file" != *.key ]]; then
        echo "✖  Blocked: staged file '$file' looks like an env file (.env*). Only .env.example may be committed." >&2
        FAIL=1
      fi
    fi
  fi
done

# ---------------------------------------------------------------- content
# Scan only non-example files — .env.example is intentionally allowed to
# contain placeholder keys (e.g. OPENAI_API_KEY=sk-sp-your-key-here).
NON_EXAMPLE_FILES=$(echo "$STAGED_FILES" | grep -v "^\.env\.example$" | grep -v "/\.env\.example$" || true)
# A rename's *source* travels with its destination: `git diff -- <destination>`
# alone cannot pair the rename, so it reports every unchanged line of the moved
# file as added — which refused correct renames of docs that quote key shapes.
RENAME_SOURCES=$(git diff --cached -M --name-status --diff-filter=R 2>/dev/null | cut -f2 || true)
if [ -n "$NON_EXAMPLE_FILES" ] || [ -n "$RENAME_SOURCES" ]; then
  # git diff over non-example files and both sides of every rename
  # (ignore errors if the pathspec fails)
  STAGED_DIFF_FOR_SECRETS=$(git diff --cached -M -- $NON_EXAMPLE_FILES $RENAME_SOURCES 2>/dev/null || echo "$STAGED_DIFF")
else
  STAGED_DIFF_FOR_SECRETS=""
fi

# Look for staged lines that assign an API key with a non-empty value.
# Empty assignments (OPENAI_API_KEY=) are allowed — they carry no secret.
if echo "$STAGED_DIFF_FOR_SECRETS" | grep -E -q '^\+\s*(OPENAI_API_KEY|FETCH_SANDBOX_API_KEY|AGILOOP_INSPECT_API_KEY|VA_GOV_API_BASE_URL|API_KEY)\s*=\s*[^[:space:]#]' 2>/dev/null; then
  echo "✖  Blocked: staged diff contains an API key assignment (e.g. OPENAI_API_KEY=...)." >&2
  echo "   Use .env (git-ignored) or a secret store; never commit keys to tracked files." >&2
  FAIL=1
fi

# Generic sk-* prefix (QwenCloud sk-sp-*, OpenAI sk-proj-*, etc.) on an added line.
if echo "$STAGED_DIFF_FOR_SECRETS" | grep -E -q '^\+\s*[^#]*sk-[A-Za-z0-9]' 2>/dev/null; then
  echo "✖  Blocked: staged diff contains a string that looks like an API key (sk- prefix)." >&2
  echo "   Rotate the key if it was already committed and remove it from the staged files." >&2
  FAIL=1
fi

# ---------------------------------------------------------------- repo rules
# Both rules run here for the same reason: the mistake they catch costs a red
# build later, and the suite cannot see a module whose branch is not merged. Each
# lives in a module the suite scans with as well, so the hook and CI cannot
# disagree about what is required, and each reads the *staged* copy, because that
# is what the commit contains.
#
#   tests/harness_imports.py         tests/test_*.py — wired into tests/hermetic.py
#                                    (that mistake reached main once, as
#                                    tests/test_job_queue_atomic.py, visible only
#                                    on the merge result)
#   tests/streamlit_option_reads.py  app/*.py — no Streamlit config option read,
#                                    because an option's value comes from the
#                                    machine rather than from the deployment
#
# The gates below are deliberately coarser than the rules (anything under tests/
# or app/ rather than only the files each rule judges): they exist to avoid paying
# for an interpreter on commits that touch neither, and *which* files count is the
# module's answer, not a second glob here that could drift away from it.
check_tests_rule=0
check_app_rule=0
if echo "$STAGED_FILES" | grep -q '^tests/'; then
  check_tests_rule=1
fi
if echo "$STAGED_FILES" | grep -q '^app/'; then
  check_app_rule=1
fi

if [ "$check_tests_rule" = 1 ] || [ "$check_app_rule" = 1 ]; then
  # An activated virtualenv, else the project's own .venv, else whatever python3
  # is on PATH — both rules are stdlib-only, so any of them reaches the same
  # verdict. No interpreter at all blocks the commit rather than skipping the
  # checks: this is the file whose whole job is to not fail open.
  PYTHON_BIN=""
  if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    PYTHON_BIN="$VIRTUAL_ENV/bin/python"
  elif [ -x ".venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
  else
    PYTHON_BIN="$(command -v python3 || command -v python || true)"
  fi
  if [ -z "$PYTHON_BIN" ]; then
    echo "✖  Blocked: cannot check the repository rules — no python3 on PATH." >&2
    echo "   Install Python and retry; the checks are not skipped, because a gate" >&2
    echo "   that silently does not run is the thing this hook exists to prevent." >&2
    FAIL=1
  else
    if [ "$check_tests_rule" = 1 ]; then
      if ! "$PYTHON_BIN" -m tests.harness_imports --staged; then
        FAIL=1
      fi
    fi
    if [ "$check_app_rule" = 1 ]; then
      if ! "$PYTHON_BIN" -m tests.streamlit_option_reads --staged; then
        FAIL=1
      fi
    fi
  fi
fi

if [[ "$FAIL" != 0 ]]; then
  echo "" >&2
  echo "Commit aborted. See SECURITY.md for secret handling, and" >&2
  echo "tests/harness_imports.py / tests/streamlit_option_reads.py for the" >&2
  echo "repository rules." >&2
  exit 1
fi

exit 0
